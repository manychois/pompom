{
  "name": "manychois/pompom",
  "description": "Modern PHP DOM-based HTML templating helpers for building reusable templates with PHP 8.5+.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Siu Pang Tommy Choi",
      "email": "manychois@manychois.com.au",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.5",
    "ext-dom": "*",
    "php-di/php-di": "^7.1.1"
  },
  "autoload": {
    "psr-4": {
      "Manychois\\Pompom\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Manychois\\Pompom\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5.55",
    "phpstan/phpstan": "^2.1.40",
    "phpstan/phpstan-strict-rules": "^2.0",
    "squizlabs/php_codesniffer": "^4.0",
    "slevomat/coding-standard": "*"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse -c phpstan.neon.dist",
    "lint": "phpcs -ps",
    "fix-lint": "phpcbf -ps"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
